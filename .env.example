# Only for development purposes. Copy this file to .env and fill the values to run the application.
POSTGRES_DB=menu
POSTGRES_USER=menu
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
API_PORT=8080

# Orígenes exactos separados por comas, sin rutas ni barra final.
# Ejemplo: https://menu.example.com,https://admin.example.com
MENU_CORS_ALLOWED_ORIGINS=
MENU_CORS_ALLOW_LOCALHOST=true

RABBITMQ_USER=menu
RABBITMQ_PASSWORD=menu
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672

# Inventory service configuration
INVENTORY_BASE_URL=http://host.docker.internal:8081
