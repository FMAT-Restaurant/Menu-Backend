# Solo para desarrollo. Copiar este archivo a .env y completar los valores para levantar el proyecto con
# Docker Compose. Compose lee .env y pasa a cada contenedor lo que declara en `environment`.

# --- PostgreSQL ---
POSTGRES_DB=menu
POSTGRES_USER=menu
# Obligatoria: Compose no arranca con la contraseña vacía.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- API ---
API_PORT=8080
# No activar `local` en Docker: ese perfil registra el mock de Inventario y espera application-local.properties.
SPRING_PROFILES_ACTIVE=

# Orígenes exactos separados por comas, sin rutas ni barra final.
# Ejemplo: https://menu.example.com,https://admin.example.com
MENU_CORS_ALLOWED_ORIGINS=
MENU_CORS_ALLOW_LOCALHOST=true

# --- RabbitMQ ---
# Usuario, clave, vhost y puerto con que Compose crea y publica su propio broker.
RABBITMQ_USER=menu
RABBITMQ_PASSWORD=menu
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
# URL de conexión del API (Spring la lee como spring.rabbitmq.addresses): amqp(s)://usuario:clave@host[:puerto][/vhost].
# Vacía, el API usa el broker de Compose con los valores de arriba. Defínela para un broker externo, por ejemplo
# amqps://usuario:clave@host/vhost (la clave va codificada como URL; el vhost, sin barra inicial extra).
RABBITMQ_URL=
# Routing key con la que Menu enlaza su cola de disponibilidad a inventory.topic.
INVENTORY_AVAILABILITY_ROUTING_KEY=inventory.recipe.availability-changed

# --- Servicio de Inventario ---
# Raíz del servicio: Menu consulta {INVENTORY_BASE_URL}/items/{id}.
INVENTORY_BASE_URL=http://host.docker.internal:8081
INVENTORY_TOKEN=
INVENTORY_TIMEOUT=3s
