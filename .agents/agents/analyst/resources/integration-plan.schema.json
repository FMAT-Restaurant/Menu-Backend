{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntegrationPlan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "change_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "decision"]
      }
    },
    "permitted_writes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "affected_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "enum": ["CREATE", "MODIFY", "DELETE", "VERIFY"]
          },
          "instructions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": ["path", "operation", "instructions", "acceptance"]
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "change_id",
    "objective",
    "decisions",
    "invariants",
    "affected_files",
    "blockers"
  ]
}
