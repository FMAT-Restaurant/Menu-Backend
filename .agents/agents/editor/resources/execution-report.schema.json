{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutionReport",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["COMPLETED", "BLOCKED"]
    },
    "created_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modified_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deleted_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verified_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "status",
    "created_files",
    "modified_files",
    "deleted_files",
    "verified_files",
    "blockers",
    "notes"
  ]
}
