# Activate with --spring.profiles.active=local. Spring Boot will automatically load this file when the "local" profile is active.
spring.datasource.url=jdbc:postgresql://localhost:5432/menu
spring.datasource.username=tony
spring.datasource.password=
# Additional browser origins, comma-separated. Localhost on any port is enabled separately.
# menu.cors.allowed-origins=https://menu.example.com,https://admin.example.com
# menu.cors.allow-localhost=false
spring.jpa.hibernate.ddl-auto=update

# Mocked inventory service, available only with the local profile (InventoryMockController). Menu calls
# GET {base-url}/inventory/items/{id} to check items and their units before saving options. An unknown id
# is answered with 404 and the error envelope, which Menu reports as 422. Outside the local profile, point
# INVENTORY_BASE_URL (menu.inventory.base-url) to the real Inventory service.
menu.inventory.base-url=http://localhost:8080/api/v1
menu.inventory.token=

# RabbitMQ configuration for local development. Menu will use this to send messages to the queue.
spring.rabbitmq.host=localhost
spring.rabbitmq.port=5672
spring.rabbitmq.virtual-host=/
spring.rabbitmq.username=guest
spring.rabbitmq.password=guest
